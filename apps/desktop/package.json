{
  "name": "@ekm/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "pnpm -C ../.. --filter @ekm/shared-types build && pnpm -C ../.. --filter @ekm/core build && tsc -p tsconfig.json && node ./scripts/copy-renderer-assets.mjs",
    "dev": "pnpm run build && electron ./dist/main/index.js",
    "typecheck": "pnpm -C ../.. --filter @ekm/shared-types build && pnpm -C ../.. --filter @ekm/core build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codemirror/basic-setup": "^0.20.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/gutter": "^0.19.9",
    "@codemirror/highlight": "^0.19.8",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "@ekm/core": "workspace:*",
    "@ekm/shared-types": "workspace:*",
    "electron": "^31.7.7",
    "zod": "^3.23.8"
  }
}
